diff -ru a/esp32_tinystories.ino b/esp32_tinystories.ino
--- a/esp32_tinystories.ino	2026-10-10 22:40:38.291776762 -0700
+++ b/esp32_tinystories.ino	2026-10-11 09:18:09.207244822 -0700
@@ -60,6 +60,17 @@
 #ifndef LOGIT_CHECKSUM
 #define LOGIT_CHECKSUM 0
 #endif
+
+// Story boundary: <|endoftext|> (VOCAB_EOT_ID) decodes to zero bytes, so the
+// loop otherwise runs straight on into a new story. 1 stops the generation
+// there; 0 keeps the fixed-length loop (benchmark mode, the original output).
+// With LOGIT_CHECKSUM the run also reports where the first boundary fell.
+#ifndef STOP_AT_EOT
+#define STOP_AT_EOT 0
+#endif
+#if (STOP_AT_EOT || LOGIT_CHECKSUM) && !defined(VOCAB_EOT_ID)
+#error "STOP_AT_EOT / LOGIT_CHECKSUM need VOCAB_EOT_ID: regenerate generated/vocab.h"
+#endif
 #if LOGIT_CHECKSUM
 #define LOGIT_CHECKSUM_TOKENS 20
 static uint64_t logit_hash[LOGIT_CHECKSUM_TOKENS];
@@ -664,6 +675,9 @@
   int pos = 0, tok = 0;
   int64_t decode_us = 0;
   int decoded = 0;
+#if LOGIT_CHECKSUM
+  int eot_step = -1, eot_bytes = 0, eot_count = 0, gen_bytes = 0;
+#endif
 
   for (int i = 0; i < n_prompt; i++) {  // prime with the prompt
     tok = PROMPT_IDS[i];
@@ -684,6 +698,16 @@
     for (int v = 0; v < model.out_vocab; v++)
       if (s.logits[v] > bv) { bv = s.logits[v]; best = v; }
     tok = best;
+#if LOGIT_CHECKSUM
+    if (tok == VOCAB_EOT_ID) {
+      if (eot_step < 0) { eot_step = step; eot_bytes = gen_bytes; }
+      eot_count++;
+    }
+    gen_bytes += VOCAB_OFF[tok + 1] - VOCAB_OFF[tok];
+#endif
+#if STOP_AT_EOT
+    if (tok == VOCAB_EOT_ID) break;  // end of story: stop instead of starting another
+#endif
     emit(tok);
     blink((step & 1) ? 40 : 8);
 
@@ -704,10 +728,17 @@
     Serial.printf("logit_hash_all %016llx (n=%d)\n",
                   (unsigned long long)fnv1a64(logit_hash, n * sizeof(uint64_t),
                                               14695981039346656037ULL), n);
+    if (eot_step >= 0)
+      Serial.printf("eot: first id %d at step %d after %d generated bytes, %d in run "
+                    "(stop_at_eot=%d)\n", VOCAB_EOT_ID, eot_step, eot_bytes, eot_count,
+                    STOP_AT_EOT);
+    else
+      Serial.printf("eot: none in %d steps (stop_at_eot=%d)\n", decoded, STOP_AT_EOT);
   }
 #endif
-  Serial.printf("throughput: %.2f tok/s   (%.1f ms/token)\n",
-                decoded * 1e6 / total_us, decode_us / 1000.0 / decoded);
+  if (decoded)  // zero when the first generated token is the boundary
+    Serial.printf("throughput: %.2f tok/s   (%.1f ms/token)\n",
+                  decoded * 1e6 / total_us, decode_us / 1000.0 / decoded);
   if (s.profile.calls) {
     float n = (float)s.profile.calls * 1000.f;
     Serial.printf("profile ms/token: input %.1f | attn %.1f | ffn %.1f | ple %.1f | head %.1f\n",
diff -ru a/tools/generate_vocab.py b/tools/generate_vocab.py
--- a/tools/generate_vocab.py	2026-10-10 18:45:02.723748458 -0700
+++ b/tools/generate_vocab.py	2026-10-11 09:18:09.207244822 -0700
@@ -29,6 +29,11 @@
 
     tok = Tokenizer.from_file(str(TOK))  # rejects PathLike
     V = tok.get_vocab_size()
+    # Story boundary. It decodes to zero bytes, so the sketch needs its id to stop
+    # on it rather than print nothing and run straight into a new story.
+    eot = tok.token_to_id("<|endoftext|>")
+    if eot is None or eot >= V:
+        raise SystemExit(f"{TOK}: no <|endoftext|> in the output vocabulary")
 
     # Raw bytes per token: decode single-id sequences. For the ASCII TinyStories
     # domain this reconstructs text exactly when pieces are concatenated.
@@ -46,6 +51,7 @@
                 "// token id -> raw UTF-8 bytes.\n")
         f.write("#ifndef VOCAB_H\n#define VOCAB_H\n")
         f.write(f"#define VOCAB_N {V}\n")
+        f.write(f"#define VOCAB_EOT_ID {eot}\n")
         f.write(f"static const unsigned char VOCAB_BLOB[{len(blob)}] = {{\n")
         for i in range(0, len(blob), 20):
             f.write("  " + ",".join(str(b) for b in blob[i:i+20]) + ",\n")
