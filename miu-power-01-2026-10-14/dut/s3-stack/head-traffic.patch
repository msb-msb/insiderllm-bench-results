+#if HEAD_SC16
+static const uint16_t *head4_sc16; // rows fp16 scales as in the file, PSRAM
+
+// fp16 -> fp32 for a normal half: rebias the exponent (15 -> 127) and widen the
+// mantissa. Equal bit for bit to half2float on every normal input; the boot
+// check confirms every head scale is normal and converts identically.
+static inline float half2float_normal(uint16_t h) {
+  uint32_t f = ((uint32_t)(h & 0x8000u) << 16) | (((uint32_t)(h & 0x7FFFu) << 13) + 0x38000000u);
+  float out; memcpy(&out, &f, 4); return out;
+}
+#else
 static const float *head4_sc;      // rows fp32 scales, PSRAM
+#endif
 
