+// Correctness gate: -DLOGIT_CHECKSUM=1 prints a 64-bit FNV-1a hash of the raw
+// logits bytes behind each of the first LOGIT_CHECKSUM_TOKENS generated tokens.
+// Hashing runs outside the timed llm_forward call (it is in total wall time).
+#ifndef LOGIT_CHECKSUM
+#define LOGIT_CHECKSUM 0
+#endif
+#if LOGIT_CHECKSUM
+#define LOGIT_CHECKSUM_TOKENS 20
+static uint64_t logit_hash[LOGIT_CHECKSUM_TOKENS];
+static uint64_t fnv1a64(const void *p, size_t n, uint64_t h) {
+  const uint8_t *b = (const uint8_t *)p;
+  for (size_t i = 0; i < n; i++) { h ^= b[i]; h *= 1099511628211ULL; }
+  return h;
+}
+#endif
